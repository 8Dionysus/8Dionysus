{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://8dionysus.local/schemas/codex_organ_fabric_plan_v1.json",
  "title": "Derived Codex organ-fabric registration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "generated_at",
    "manifest_digest",
    "observation_digest",
    "selected_registration_count",
    "selected_tool_count",
    "rendered_registration_count",
    "mutation_allowed",
    "fresh_client_required",
    "actions",
    "blockers",
    "claim_limits",
    "plan_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "8dionysus_codex_organ_fabric_plan_v1"
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "observation_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "selected_registration_count": {
      "type": "integer",
      "minimum": 0
    },
    "selected_tool_count": {
      "type": "integer",
      "minimum": 0
    },
    "rendered_registration_count": {
      "type": "integer",
      "minimum": 0
    },
    "mutation_allowed": {
      "type": "boolean"
    },
    "fresh_client_required": {
      "const": true
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "registration_name",
          "action",
          "reason_codes"
        ],
        "properties": {
          "registration_name": {
            "type": "string"
          },
          "action": {
            "enum": [
              "withhold",
              "add",
              "replace",
              "retain_exact",
              "retain_legacy_until_replacement_gates",
              "remove_after_receipt",
              "investigate_unmanaged"
            ]
          },
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_limits": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
